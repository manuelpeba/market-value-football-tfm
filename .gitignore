# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Jupyter
.ipynb_checkpoints/

# Testing / cache
.pytest_cache/
.mypy_cache/
.cache/

# =========================
# Virtual environments
# =========================
.venv/
venv/
env/
ENV/

# Environment variables
.env
.env.*

# =========================
# Data
# =========================
data/raw/*
data/interim/*
data/processed/*
data/external/*

!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
!data/external/.gitkeep

# Optional sample datasets
!data/processed/sample/
!data/processed/sample/**

# Versioned analytical outputs
!data/outputs/
!data/outputs/**
!data/outputs/**/*.csv

# Large / binary files
*.parquet
*.feather
*.csv.gz
*.pkl
*.joblib

# =========================
# Reports
# =========================
outputs/
mlruns/

reports/figures/*
reports/tables/*
reports/rankings/*
reports/scouting_reports/*
reports/model_diagnostics/*

!reports/figures/.gitkeep
!reports/tables/.gitkeep
!reports/rankings/.gitkeep
!reports/scouting_reports/.gitkeep
!reports/model_diagnostics/.gitkeep

# Allow selected versioned report outputs if needed
!reports/tables/*.csv
!reports/rankings/*.csv
!reports/model_diagnostics/*.csv

# =========================
# Logs
# =========================
*.log

# =========================
# OS
# =========================
.DS_Store
Thumbs.db
desktop.ini

# =========================
# IDEs
# =========================
.vscode/
.idea/

# =========================
# Streamlit
# =========================
.streamlit/secrets.toml

# =========================
# Coverage
# =========================
.coverage
htmlcov/

# =========================
# Temporary files
# =========================
tmp/
temp/

# =========================
# Artifacts
# =========================
artifacts/models/*
artifacts/scalers/*
artifacts/encoders/*
artifacts/feature_importance/*
artifacts/predictions/*

!artifacts/models/.gitkeep
!artifacts/scalers/.gitkeep
!artifacts/encoders/.gitkeep
!artifacts/feature_importance/.gitkeep
!artifacts/predictions/.gitkeep

# Allow lightweight model diagnostics / feature importance if CSV
!artifacts/feature_importance/*.csv
!artifacts/predictions/*.csv

# MLflow metadata
artifacts/metadata/*.db
